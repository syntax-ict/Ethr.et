# ETHR - editor defaults across PHP, TypeScript and PowerShell.
#
# .gitattributes already normalises line endings in Git; this normalises what
# editors write in the first place, which matters on a repo worked on from both
# Windows and Linux.

root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.{js,jsx,ts,tsx,mjs,cjs,json,jsonc,css,scss,yml,yaml}]
indent_size = 2

[*.md]
# Two trailing spaces are a hard line break in Markdown.
trim_trailing_whitespace = false

[*.{ps1,psm1}]
# PowerShell tolerates LF, but Windows-only tooling is happier with CRLF and
# these three launchers are Windows-only by design.
end_of_line = crlf

[Makefile]
indent_style = tab

[*.{yml,yaml}]
indent_style = space
