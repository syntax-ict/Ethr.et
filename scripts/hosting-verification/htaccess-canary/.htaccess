# ETHR web-server canary — a deliberately harmless .htaccess.
#
# This exists because the main probe cannot answer these questions. That probe
# lives in ~/ and is never served by Apache, by design: it prints grants and
# disable_functions. But "is .htaccess honoured?" can only be answered by
# something the web server actually serves.
#
# So this directory is the opposite trade: it IS web-reachable, and it
# discloses nothing. It reports four booleans and no environment detail.
#
# What it proves, and why each matters for ETHR:
#
#   1. mod_rewrite        - the whole deployment routes through a repointed
#                           index.php. Without it, nothing resolves.
#   2. mod_headers        - next.config.ts defines CSP, HSTS, X-Frame-Options
#                           and Permissions-Policy. Under static hosting those
#                           vanish with the Node server and must come from here.
#   3. deny rules         - the deployment blocks .env, .git, composer.json and
#                           storage/ with exactly this mechanism. If Apache
#                           ignores .htaccess, APP_KEY and the database password
#                           become web-readable while the app still appears to
#                           work. That is the failure mode worth paying for.
#   4. Authorization pass - Sanctum needs the Authorization and X-XSRF-Token
#                           headers forwarded to PHP. Under CGI/FastCGI they are
#                           stripped unless restored here.
#   5. Static shadowing  - step 4a of the deployment runbook rests on a real
#                           file in the document root winning over the rewrite.
#                           The Apache half is readable in that .htaccess (!-f);
#                           whether Plesk's nginx serves from disk before Apache
#                           sees the request at all is a property of THIS host
#                           and was previously asserted rather than measured.
#
# If the server is nginx-only, or Apache runs AllowOverride None, every rule
# below is silently ignored - no error, no log. That is exactly what we are
# testing for, and it is why "the page loaded" is not a pass.

<IfModule mod_rewrite.c>
    RewriteEngine On

    # 1. Rewrite proof. /REWRITE_OK must reach canary.php with the flag set.
    RewriteRule ^REWRITE_OK$ canary.php?rewrite=1 [L,QSA]

    # 5. Shadow proof. shadow.txt exists on disk AND is rewritten here, so the
    #    response says which layer resolved the request first. Deliberately
    #    unguarded by !-f: that guard is what the real deployment's .htaccess
    #    uses, and guarding here would answer the question by construction
    #    rather than by measurement.
    RewriteRule ^shadow\.txt$ canary.php?shadow=txt [L,QSA]

    # 5b. The same bait with a STATIC extension. Plesk's "serve static files
    #     directly by nginx" block always covers js/css/images; whether it
    #     covers .txt varies by version. Measured 2026-09-18: with a block that
    #     excludes .txt, shadow.txt reports "the rewrite won" while shadow.js
    #     is shadowed — a false negative on G0-B.5 for exactly the file types
    #     the deployment ships. Test both; they can legitimately disagree.
    RewriteRule ^shadow\.js$ canary.php?shadow=js [L,QSA]

    # 4. Header forwarding, same directives the real deployment uses.
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
</IfModule>

<IfModule mod_headers.c>
    # 2. Header proof, plus the real security headers so a scan of this
    #    directory reflects what the deployment would set.
    Header always set X-Ethr-Canary "headers-ok"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
</IfModule>

# 3. Deny proof. secret.txt.probe stands in for .env and must return 403.
#    Two mechanisms, because which one works varies by Apache version.
<FilesMatch "^secret\.txt\.probe$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
