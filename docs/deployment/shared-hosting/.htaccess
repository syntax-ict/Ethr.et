# ETHR — Document root .htaccess for Ethio Telecom shared hosting (Plesk)
#
# Goes at <DOCROOT>/.htaccess. Companion to the repointed <DOCROOT>/index.php.
# <DOCROOT> is the served directory: `httpdocs/`, Plesk's default and the target
# confirmed by measurement on 2026-09-24. See DEPLOYMENT.md "Deploy path".
#
# (Corrected 2026-09-25. These two lines used to end "It is NOT httpdocs/",
# left over from when the target was believed to be `ethr.et/` — so the file
# named httpdocs/ as the target and denied it in the next sentence. A
# deployment file that contradicts itself about the document root is the one
# place that mistake is expensive: the wrong answer web-serves ~/ethr/api/.env.)
#
# (see DEPLOYMENT.md step "Deploy the backend") — this file does the routing and
# security work nginx did on the VPS, rewritten for what Apache/Plesk actually
# offers on shared hosting. `infrastructure/nginx-common.conf` is where that
# work came from historically; it is NOT a file this one must be kept in sync
# with. See the response-headers section for why that distinction is load-bearing.
#
# Layout this assumes:
#   ~/ethr/              Laravel app — NOT web-accessible (not the document
#                        root and not beneath it)
#   <DOCROOT>/           document root — `httpdocs/` (Plesk default)
#     index.php           copy of api/public/index.php, require paths repointed
#     .htaccess           this file
#     .well-known/        leave alone — ACME HTTP-01 challenge path
#     _next/, assets, …   frontend static output, IF B5 says no Node runtime
#
# Two things this file cannot do that nginx did, and what replaces them:
#   - Per-route rate limiting (nginx `limit_req`) — Laravel's own throttle
#     middleware already covers every route CLAUDE.md's rate-limit policy
#     lists (RateLimitLoginAttempts, AppServiceProvider's named limiters), so
#     nothing is actually unenforced — it just moved from the edge to the app.
#   - A separate WebSocket upgrade block for Reverb — moot, Reverb is not
#     deployed here (BROADCAST_CONNECTION=log; see B1-B5_GATE_REPORT.md).

<IfModule mod_rewrite.c>
    RewriteEngine On

    # ── Security: deny everything that must never be served ────────────────
    # Defence in depth even though .env/.git/vendor are NOT under this
    # document root in this layout (they live in ~/ethr, outside the document root
    # entirely) — a future document-root change or a misplaced file must not
    # silently become web-accessible.
    RewriteRule ^(\.env.*|\.git|composer\.(json|lock)|package(-lock)?\.json|artisan|phpunit\.xml)$ - [F,L]

    # Never serve storage/ or bootstrap/cache/ directly if either is ever
    # placed under this document root by mistake — Laravel's own public/
    # boundary is the only thing that should ever be reachable.
    RewriteRule ^(storage|bootstrap/cache)(/|$) - [F,L]

    # ── Handle Authorization Header ─────────────────────────────────────────
    # Some Apache/FastCGI configurations drop the Authorization header before
    # PHP sees it. Laravel's own default .htaccess (api/public/.htaccess)
    # carries this same rule — kept identical rather than reinvented.
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # ── Handle X-XSRF-Token Header ──────────────────────────────────────────
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # ── ACME HTTP-01 challenge path — never rewrite this ────────────────────
    # This is what makes the per-tenant TLS fallback work (B2) — see
    # B1-B5_GATE_REPORT.md. Must resolve to a real file under .well-known/,
    # untouched by anything below.
    RewriteCond %{REQUEST_URI} ^/\.well-known/acme-challenge/ [NC]
    RewriteRule ^ - [L]

    # ── API and Sanctum routes → Laravel's front controller ─────────────────
    # Laravel's own public/.htaccess pattern: rewrite to index.php UNLESS the
    # request already matches a real file or directory. Since api/public/*
    # (this file, index.php, favicon.ico, robots.txt) is now the whole
    # document root alongside the frontend build, this single rule handles
    # BOTH the API and Laravel's own static assets (favicon, robots.txt)
    # correctly — a real file always wins over the rewrite.
    RewriteCond %{REQUEST_URI} ^/(api|sanctum)(/|$) [NC]
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]

    # ── Everything else → frontend ───────────────────────────────────────────
    #
    # ============================================================
    # BRANCH A — Node.js runtime available (B5 = yes). DO NOT USE
    # this .htaccess branch; delete this whole "Everything else"
    # block instead and let Plesk's Node.js/Passenger integration
    # own routing for every non-/api, non-/sanctum path. Passenger
    # inserts its own front-controller rule ahead of this file when
    # the Node.js app is enabled for the domain — a second catch-all
    # rule here would conflict with it. See DEPLOYMENT.md "Frontend
    # (Node.js path)".
    # ============================================================
    #
    # ============================================================
    # BRANCH B — no Node.js runtime (B5 = no): static export served
    # from this same document root. UNCOMMENT the four groups below,
    # in this order. This is a client-side-routed SPA past the first
    # paint (see D6 in docs/MIGRATION_STATE.md: 0 API routes, 0
    # server actions, but middleware.ts's host-based rules must be
    # reimplemented here — that is group 0, immediately below. It used to
    # be further down; see the note in group 0 for why moving it was not
    # cosmetic).
    #
    # REWRITTEN 2026-09-26, and the previous version would have 404'd
    # every page on the site. It said "Next static export writes
    # app/foo/page.tsx to /foo/index.html" and rewrote to
    # $1/index.html. Measured against the pinned Next 16.3.5: the
    # export writes out/features.html, not out/features/index.html.
    # The /index.html form is what you get with trailingSlash: true,
    # which next.config.ts does not set. See docs/audit/BASELINE.md
    # §19; the rules below are the ones that were measured serving
    # the real thing, not the ones that were reasoned about.
    # ============================================================
    #
    # ── 0. middleware.ts's host-based rules, BRANCH B ONLY ───────
    #
    # src/src/middleware.ts refuses /admin on any host except
    # admin.ethr.et, and redirects tenant routes (/dashboard, /employees,
    # /attendance, /leave, /payroll, /organization, /directory, /devices,
    # /shifts, /reports, /settings, /announcements, /approvals, /profile —
    # the exact list in that file) away from the platform host. Under a
    # static export the middleware never runs — Next says so itself during
    # the build: "Statically exporting a Next.js application disables API
    # routes and middleware." So this is the enforcement on that target,
    # not a duplicate of one.
    #
    # MOVED HERE 2026-09-26, FROM BELOW THE FALLBACKS, WHERE IT COULD NEVER
    # FIRE. It used to sit after group 2, and group 2 is
    # "RewriteRule ^(.+)$ /$1.html [L]" — /admin matches it, admin.html
    # exists, and [L] ends the round. Measured against a real export served
    # under these rules: /admin on a tenant host returned 200, not 403. A
    # deny rule placed after a catch-all is not a deny rule.
    #
    # Ordering is therefore load-bearing here, not stylistic. Group 0 before
    # group 1.
    #
    # !-f is on the redirect deliberately: without it the platform host
    # bounces its own static files — /robots.txt, /sitemap.xml, /og.png are
    # none of them in the exclusion list below.
    #
    # RewriteCond %{HTTP_HOST} ^admin\.ethr\.et$ [NC]
    # RewriteCond %{REQUEST_FILENAME} !-f
    # RewriteCond %{REQUEST_URI} !^/admin
    # RewriteCond %{REQUEST_URI} !^/(login|logout|_next|favicon\.ico|sw\.js|manifest)
    # RewriteRule ^ /admin/ [L,R=302]
    #
    # RewriteCond %{HTTP_HOST} !^admin\.ethr\.et$ [NC]
    # RewriteRule ^admin(/|$) - [F,L]
    #
    # What this is and is not. It is a ROUTING control: it decides which
    # host may reach the console's HTML. It is NOT the authorization
    # boundary, and must never be mistaken for one — the console's data
    # lives behind /api/v1/admin, where EnsurePlatformContext returns 404 on
    # any host that resolves a tenant, Gate::authorize('admin.manage') is on
    # every action, and RequirePlatformMfa is on the route group. Those three
    # are what protect the data, they are server-side, and this migration
    # does not touch them.
    #
    # ── 1. Entity routes: /employees/<ULID> and the other three ──
    #
    # Only one shell per route exists — out/employees/__id__.html —
    # because ids are tenant data and there is nothing to enumerate
    # at build time. These rules hand that shell to every id, and
    # src/src/lib/hooks/useRouteId.ts reads the id back out of the
    # URL. The four route prefixes are the four [id] segments in
    # src/src/app; a fifth one needs a line here or it 404s.
    #
    # Order matters. ^…/[^/]+$ also matches "…/ABC.txt", so the RSC
    # payload rule has to be reached first.
    #
    # RewriteCond %{REQUEST_FILENAME} !-f
    # RewriteRule ^(employees|payroll|devices|admin/tenants)/[^/]+/(__next\..*)$ /$1/__id__/$2 [L]
    #
    # RewriteCond %{REQUEST_FILENAME} !-f
    # RewriteRule ^(employees|payroll|devices|admin/tenants)/[^/]+\.txt$ /$1/__id__.txt [L]
    #
    # RewriteCond %{REQUEST_FILENAME} !-f
    # RewriteRule ^(employees|payroll|devices|admin/tenants)/[^/]+$ /$1/__id__.html [L]
    #
    # ── 2. Every other route: the export writes <path>.html ──────
    #
    # RewriteCond %{REQUEST_FILENAME} !-f
    # RewriteCond %{DOCUMENT_ROOT}/$1.html -f
    # RewriteRule ^(.+)$ /$1.html [L]
    #
    # ── 3. Anything with no file behind it ───────────────────────
    #
    # RewriteCond %{REQUEST_FILENAME} !-f
    # RewriteCond %{REQUEST_FILENAME} !-d
    # RewriteRule ^ /404.html [L]
    #
    # ── Known, measured, and deliberately not worked around ──────
    #
    # A client-side navigation to an entity route also prefetches
    # /employees/<id>/__next.employees.$d$id.__PAGE__.txt, and that
    # 404s: Next asks for the segment with dots where the exporter
    # wrote it with slashes. Group 1's first rule catches the other
    # segment files; this one has no rule that can reach it without
    # hardcoding a Next-internal filename per route, which would
    # break silently on the next Next upgrade.
    #
    # The cost is one failed request per navigation, and nothing
    # else: Next falls back to the full RSC payload, which group 1's
    # second rule serves. Measured working in a browser — deep link,
    # nested route, client-side navigation, back and forward — on
    # 2026-09-26, with no hydration error. Do not "fix" this by
    # pointing the 404 fallback at an entity shell; that would turn
    # every genuine 404 into a page that looks like it loaded.

</IfModule>

# ── Response headers ─────────────────────────────────────────────────────
#
# THIS BLOCK IS THE AUTHORITY for shared hosting. Nothing else needs to agree
# with it, and nothing else is checked against it.
#
# It used to say: "Mirrors infrastructure/nginx-common.conf's security headers.
# Kept byte-identical in content (not just intent) so a security scan run
# against this deployment matches the one already run against the VPS."
#
# **That was false when written, and measurably so — 2026-09-25.** The two CSPs
# differ in seven places, and this file's own comment three lines below already
# explained two of them, so the claim contradicted its own neighbour:
#
#   img-src          nginx: 'self' data: blob:        here: + https:
#   font-src         nginx: 'self'                    here: + data:
#   connect-src      nginx: 'self' wss:               here: no wss:
#   frame-ancestors  nginx: absent                    here: 'none'
#   base-uri         nginx: absent                    here: 'self'
#   form-action      nginx: absent                    here: 'self'
#   script-src       nginx: 'self'                    here: + 'unsafe-inline'
#
# (Six until 2026-09-26. `script-src` is the seventh and it is the one that goes
# the OTHER way — see below.)
#
# Every difference is deliberate, and this file is the stricter of the two in six
# of the seven: it adds the three clickjacking/injection directives nginx never
# carried, and drops `wss:` because Reverb is not deployed here. So the sync
# obligation was not merely unmet — meeting it would have LOOSENED this
# deployment on those six.
#
# **`script-src` is the exception, and it must not be read past.** This file
# allows `'unsafe-inline'` and nginx does not, so on that one directive this is
# the LOOSER of the two. It is not a preference: a static export has no server to
# mint a nonce, and the build emits three un-nonced inline scripts — measured, the
# strict form leaves the application unable to hydrate at all. The reasoning is at
# the directive itself. A reviewer comparing the two files should expect this row
# to differ and should check that no OTHER row has drifted the same way.
#
# The practical consequence, and the reason this is spelled out rather than
# quietly corrected: a VPS security scan does not transfer here. Scan this
# deployment. And `infrastructure/nginx-common.conf` can be deleted without
# touching this file, which is what the sync claim was preventing.
<IfModule mod_headers.c>
    Header always set X-Frame-Options "DENY"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(self), microphone=(), geolocation=(self)"

    # img-src widened for tenant branding logos (PUT /settings/branding
    # stores a URL, rendered straight into <img src> across the sidebar,
    # header, mobile nav and kiosk) — same reasoning as next.config.ts's CSP.
    # connect-src has no wss: — Reverb is not deployed here.
    # script-src needs 'unsafe-inline', and this is the measurement that says so
    # rather than an assumption — 2026-09-26, a real `output: "export"` build
    # served under these exact headers:
    #
    #   script-src 'self'                  3 CSP violations per page, React error
    #                                      #412, nothing hydrates. /employees/<id>
    #                                      sits on "በመጫን ላይ..." forever and / never
    #                                      negotiates a language. The HTML still
    #                                      renders, so it looks like a broken app
    #                                      rather than a header problem.
    #   script-src 'self' 'unsafe-inline'  0 violations, 0 hydration errors, every
    #                                      route renders and navigates.
    #
    # The build emits three inline <script> blocks — ~13 KB, the theme bootstrap
    # plus the RSC payload — and Next does not nonce them. There is no way to
    # allow those and keep the directive strict; a nonce needs a server to mint
    # one per response, which is the thing this target does not have.
    #
    # 'unsafe-eval' is deliberately NOT here, even though `next.config.ts` grants
    # it on the Node targets. Measured: zero violations without it, so the
    # production bundle does not need it. This policy is tighter than the VPS's,
    # not looser, and should stay that way.
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
</IfModule>

# ── Static asset caching ──────────────────────────────────────────────────
<IfModule mod_expires.c>
    ExpiresActive On
    <FilesMatch "\.(js|css|png|jpg|jpeg|gif|ico|svg|woff2?|ttf|eot)$">
        ExpiresDefault "access plus 1 year"
        Header set Cache-Control "public, immutable"
    </FilesMatch>
</IfModule>

# ── PHP execution time for the payroll/import routes ─────────────────────
# 120s, because Apache/PHP-FPM here has ONE execution-time budget for the whole
# vhost and the payroll and import routes are the ones that need the most. This
# layer cannot express a route-specific override, so the highest figure wins.
#
# (Historically: nginx gave /api/v1/payroll and /api/v1/employees/import 120s
# and everything else 30s. That is where the number comes from; it is not a
# constraint this file inherits.)
#
# (Corrected 2026-09-25. This ended "and rely on Horizon's `payroll` queue
# timeout (1800s, config/horizon.php) no longer applying". **There is no
# Horizon.** It was removed in cdf85d1: `laravel/horizon` appears zero times in
# api/composer.lock and api/config/horizon.php does not exist — both measured
# today. There is also no `payroll` queue; QueueHealth::QUEUES is default,
# attendance, notifications, exports. The sentence reasoned about a timeout in
# a config file that has not existed for weeks.)
<IfModule mod_php.c>
    php_value max_execution_time 120
</IfModule>
# If PHP runs as PHP-FPM/CGI rather than mod_php (verify with B4), set the
# same value in Plesk → PHP Settings instead; php_value directives are
# silently ignored under FPM and Plesk logs nothing when they are.
