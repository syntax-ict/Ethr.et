# Version control
.git
.gitignore

# Frontend — has its own build context (src/), never needed by API image builds
src/node_modules
src/.next
src/out
src/coverage
src/test-results
src/playwright-report
src/lighthouse-reports

# Backend — rebuilt inside the image, never copy host state in
api/vendor
api/node_modules
# Laravel's package-discovery manifest, written by a *dev* `composer install`
# and gitignored (api/bootstrap/cache/.gitignore is `*`), so it is pure local
# state, and docker/php/Dockerfile:35 runs `composer install --no-scripts`,
# which skips the `package:discover` that would rewrite it. Left out of the
# context, Laravel rebuilds the manifest at boot from
# vendor/composer/installed.json.
#
# The rule was written for api/Dockerfile.prod, which added --no-dev: a
# copied-in manifest then listed laravel/pail, sail, collision, tinker and
# termwind while their classes were absent, and `php artisan view:cache` died
# with "Class Laravel\Pail\PailServiceProvider not found". That image went with
# the VPS stack on 2026-09-26. The exclusion stays because the manifest is local
# state either way, and it is invisible on a fresh clone (nothing to copy).
api/bootstrap/cache/*.php
# An absolute symlink into a container path, so it dangles on the host and
# buildkit refuses the whole context with "invalid file request". The image
# creates its own link (docker/php/Dockerfile:41) against the real WORKDIR.
api/public/storage
api/storage/logs/*
api/storage/framework/cache/*
api/storage/framework/sessions/*
api/storage/framework/views/*
api/.env
api/.env.*
!api/.env.example

# Docs, editor, OS cruft
docs
*.md
.vscode
.idea
.DS_Store
Thumbs.db

# Claude Code worktrees / local state
.claude
