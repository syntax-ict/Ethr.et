# ETHR Frontend Environment Variables
# Copy this file to .env.local for development or .env.production for production

NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=ETHR
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Reverb WebSocket (real-time notifications)
NEXT_PUBLIC_REVERB_HOST=localhost
NEXT_PUBLIC_REVERB_PORT=8080
NEXT_PUBLIC_REVERB_SCHEME=http
NEXT_PUBLIC_REVERB_APP_KEY=ethr-reverb-key

# Observability (self-hosted Sentry)
# Leave the DSN empty to disable reporting — that is the default for development
# and CI. The DSN's origin is added to the CSP connect-src automatically at build
# time (see next.config.ts); without that the browser blocks events silently.
# NEXT_PUBLIC_SENTRY_DSN=https://<key>@sentry.your-host.et/<project>
# NEXT_PUBLIC_SENTRY_ENVIRONMENT=production
# NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1

# Source map upload at build time (optional). Without SENTRY_AUTH_TOKEN the upload
# step is disabled entirely, so builds never fail on a missing token.
# SENTRY_ORG=ethr
# SENTRY_PROJECT=ethr-web
# SENTRY_AUTH_TOKEN=
