# =========================================================
# ETHR Frontend — Local Development Environment
# Copy to .env.local and fill in values
# =========================================================

# API URL — Laravel backend
# For `php artisan serve`: http://localhost:8000
# The shared-hosting rehearsal (scripts/local-production/) serves the built
# frontend and the API from one origin, http://localhost:8081, and needs no
# value here.
NEXT_PUBLIC_API_URL=http://localhost:8000

# App name (shown in browser title and branding)
NEXT_PUBLIC_APP_NAME=ETHR

# App base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# WebSocket / Reverb URL. Realtime is off unless NEXT_PUBLIC_REVERB_APP_KEY is
# set; it must match REVERB_APP_KEY in api/.env. Leave the key out to test the
# polling fallback that production uses.
NEXT_PUBLIC_REVERB_HOST=localhost
NEXT_PUBLIC_REVERB_PORT=8080
NEXT_PUBLIC_REVERB_SCHEME=http
NEXT_PUBLIC_REVERB_APP_KEY=ethr-reverb-key
