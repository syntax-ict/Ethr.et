# =========================================================
# ETHR Frontend - Production Environment
# =========================================================
#
# NEXT_PUBLIC_* ONLY. This file is tracked in Git on purpose: every value here
# is compiled into the client bundle and served to every visitor, so none of it
# is secret, and the production build needs it.
#
# Never add a server-side secret to this file. An API token, signing key or
# database credential put here would be both committed and shipped to the
# browser. Those belong in the host environment.

NEXT_PUBLIC_API_URL=https://ethr.et
NEXT_PUBLIC_APP_NAME=ETHR
NEXT_PUBLIC_APP_URL=https://ethr.et
# No NEXT_PUBLIC_REVERB_* on purpose. There is no Reverb server in production,
# and lib/echo.ts only opens a socket when NEXT_PUBLIC_REVERB_APP_KEY is set.
NEXT_TELEMETRY_DISABLED=1
NEXT_PUBLIC_ROOT_DOMAIN=ethr.et
# The origin the public site is actually served from, for canonical tags,
# robots.txt and the sitemap (lib/site-url.ts). The host 301s the apex to `www`
# (Plesk's preferred-domain setting), so the apex default made every canonical
# URL a redirect (production QA 2026-10-11, P13). If the host's preference ever
# changes to the apex, change this line with it.
NEXT_PUBLIC_SITE_URL=https://www.ethr.et
