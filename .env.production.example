# =========================================================
# ETHR — Root Docker Compose Environment (production)
#
# docker-compose.prod.yml resolves ${VAR} placeholders (mariadb root/app
# credentials, redis password, minio keys, frontend build args) from a
# `.env` file in this directory — that is a *separate* mechanism from
# `env_file: api/.env.production`, which only injects vars into the api/
# worker/scheduler/reverb containers' own process environment. Without
# this file, `docker compose -f docker-compose.prod.yml up` resolves
# every ${VAR} below to an empty string (mariadb refuses to start with a
# blank root password), so this file is required, not optional.
#
# Copy to `.env` at the repo root and fill in real values. The same
# database/redis/minio credentials must also be set in api/.env.production
# (see that file's REQUIRED markers) — the two files are not linked
# automatically, keep them in sync by hand.
# =========================================================

# ── MariaDB (matches api/.env.production DB_* block) ──
DB_ROOT_PASSWORD=                 # REQUIRED: strong random password
DB_DATABASE=ethr
DB_USERNAME=ethr
DB_PASSWORD=                      # REQUIRED: strong random password, matches api/.env.production DB_PASSWORD

# Read-replica account. docker-compose.prod.yml provisions the replica container
# with these as MARIADB_USER/MARIADB_PASSWORD, and api/.env.production points
# Laravel's read connection at the same pair. They were previously absent from
# both files while the compose default (ethr_read) still applied, so Laravel
# authenticated to the replica as `ethr` and every read failed.
DB_READ_USERNAME=ethr_read
DB_READ_PASSWORD=                 # REQUIRED: matches api/.env.production DB_READ_PASSWORD

# ── Redis (matches api/.env.production REDIS_PASSWORD) ──
REDIS_PASSWORD=                   # REQUIRED: strong random password

# ── MinIO (matches api/.env.production MINIO_ACCESS_KEY / MINIO_SECRET_KEY) ──
MINIO_ACCESS_KEY=                 # REQUIRED
MINIO_SECRET_KEY=                 # REQUIRED

# ── Service scaling ──
# Intentionally absent. API_REPLICAS / WORKER_REPLICAS / REVERB_REPLICAS used to
# live here and no longer do anything, because raising them did not do what the
# name promised:
#
#   api, reverb — infrastructure/nginx.conf declares static upstreams
#     (`server api:9000;`), which nginx resolves ONCE at startup. A second
#     replica got no traffic at all while still consuming its reservations.
#     Scaling these needs `resolver 127.0.0.11 valid=10s;` and a variable-based
#     fastcgi_pass/proxy_pass in nginx first.
#
#   worker — replaced by three purpose-built services (worker-realtime,
#     worker-notifications, worker-heavy). Queue throughput is now tuned with
#     `maxProcesses` per supervisor in api/config/horizon.php, which is where
#     the memory ceiling is actually decided, rather than by duplicating every
#     supervisor into a second container.

# ── Frontend build args ──
# Next.js inlines NEXT_PUBLIC_* at image BUILD time (docker compose build),
# not at container start — changing these after the frontend image is
# built requires a rebuild, `env_file:`/`environment:` at runtime has no
# effect on them. Set to your real domain before the first build.
NEXT_PUBLIC_API_URL=https://ethr.et
NEXT_PUBLIC_APP_NAME=ETHR
NEXT_PUBLIC_APP_URL=https://ethr.et
# The tenant selector. docker-compose.prod.yml passes this as a build arg and it
# is what makes the apex, admin.<root> and {tenant}.<root> hosts distinguishable
# — the basis of the hostname-aware login and the /admin guard in middleware.ts.
# It was missing from this template while the compose file already read it.
NEXT_PUBLIC_ROOT_DOMAIN=ethr.et
NEXT_PUBLIC_REVERB_HOST=ethr.et
NEXT_PUBLIC_REVERB_PORT=443
NEXT_PUBLIC_REVERB_SCHEME=https
# REQUIRED: must match REVERB_APP_KEY in api/.env.production exactly.
# This is the key the *browser* presents to Reverb. Leaving it blank does not
# fail the build — src/lib/echo.ts falls back to the literal "ethr-key", which
# the server rejects, so every WebSocket connection dies and in-app
# notifications, live device status and attendance updates silently stop
# working while the rest of the app looks perfectly healthy.
NEXT_PUBLIC_REVERB_APP_KEY=
