<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <!--
        force="true" is required, not cosmetic. Without it PHPUnit leaves any
        variable that already exists in the real environment alone — and the
        api container exports DB_CONNECTION=mariadb, CACHE_STORE=redis,
        SESSION_DRIVER=redis and QUEUE_CONNECTION=redis (see docker-compose.yml).
        Running the suite in that container therefore pointed it at the live
        MariaDB and the live Redis: every test tried to create its own
        `ethr_test_N` database, which the `ethr` user has no grant for, and the
        shared Redis carried rate-limiter state between runs so requests came
        back 429. That surfaced as ~1200 failures that had nothing to do with
        the code under test. Forcing makes this file authoritative wherever the
        suite runs.
    -->
    <php>
        <!--
            The whole suite runs in one PHP process, so allocations accumulate
            across ~1350 tests in a way no single web request ever does. At the
            256M that docker/php/php.ini sets for PHP-FPM the run dies partway
            through with "Allowed memory size exhausted" — reported as a fatal
            error rather than a test failure, so it reads like a broken suite
            instead of an exhausted one. Raised here rather than in php.ini so
            the FPM runtime keeps its production-shaped limit.
        -->
        <ini name="memory_limit" value="1G"/>
        <env name="APP_ENV" value="testing" force="true"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file" force="true"/>
        <env name="BCRYPT_ROUNDS" value="4" force="true"/>
        <env name="BROADCAST_CONNECTION" value="null" force="true"/>
        <env name="CACHE_STORE" value="array" force="true"/>
        <env name="DB_CONNECTION" value="sqlite" force="true"/>
        <env name="DB_DATABASE" value=":memory:" force="true"/>
        <env name="DB_URL" value="" force="true"/>
        <!--
            Pinned because FileStorageService now resolves the *configured* disk
            rather than the literal 'minio' it used to hardcode. Eighteen test
            sites call Storage::fake('minio'), and a fake only replaces the disk
            it names — so without this the suite's disk would be whatever the
            surrounding environment's FILESYSTEM_DISK happened to be, and those
            fakes would stop intercepting the moment it differed.

            The value is a disk *name*, not a backend: Storage::fake swaps in an
            in-memory local driver whatever the name is. Pinning it here keeps
            phpunit.xml authoritative for what the test environment is, which is
            the same reason every other variable in this block is forced.
        -->
        <env name="FILESYSTEM_DISK" value="minio" force="true"/>
        <env name="MAIL_MAILER" value="array" force="true"/>
        <env name="QUEUE_CONNECTION" value="sync" force="true"/>
        <env name="SESSION_DRIVER" value="array" force="true"/>
        <env name="PULSE_ENABLED" value="false" force="true"/>
        <env name="TELESCOPE_ENABLED" value="false" force="true"/>
        <env name="NIGHTWATCH_ENABLED" value="false" force="true"/>
    </php>
</phpunit>
