# ========================================
# ETHR — Environment Configuration
# ========================================

APP_NAME=ETHR
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=UTC

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

# ── Database ──
DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ethr
DB_USERNAME=ethr
DB_PASSWORD=

# ── Redis ──
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ── Cache / Queue / Session ──
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=480
SESSION_DOMAIN=.ethr.et

# ── Broadcasting (Reverb) ──
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=ethr
REVERB_APP_KEY=ethr-reverb-key
REVERB_APP_SECRET=ethr-reverb-secret
REVERB_HOST=0.0.0.0
REVERB_PORT=8080

# ── File Storage (MinIO) ──
FILESYSTEM_DISK=s3
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=ethr_minio
MINIO_SECRET_KEY=ethr_minio_secret
MINIO_BUCKET=ethr
MINIO_USE_PATH_STYLE=true

# ── Mail ──
MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@ethr.et"
MAIL_FROM_NAME="ETHR"

# ── Sanctum ──
SANCTUM_STATEFUL_DOMAINS=localhost:3000,ethr.et,*.ethr.et

# ── CORS ──
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ── Logging ──
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# ── Hashing ──
BCRYPT_ROUNDS=12

# ── SMS (Production) ──
SMS_DRIVER=log
# SMS_DRIVER=ethiotelecom
# ETHIOTELECOM_API_KEY=
# ETHIOTELECOM_SENDER=

# ── Horizon ──
HORIZON_PREFIX=ethr_horizon:
