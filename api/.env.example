# ========================================
# ETHR — Environment Configuration
# ========================================
# Copy this file to .env and fill in the values.
# For production, copy to .env.production and set APP_ENV=production.

APP_NAME=ETHR
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8888
APP_TIMEZONE=UTC

# The bare domain tenants live under, so ResolveTenant can tell the apex
# (`ethr.et` — no tenant) from a tenant (`habru.ethr.et` — tenant "habru").
# Leave EMPTY for single-host local development on localhost; set it in
# production, where counting labels is not enough to identify the apex.
#
# To exercise the hostname model locally instead, set `APP_DOMAIN=localhost` and
# `NEXT_PUBLIC_ROOT_DOMAIN=localhost` on the frontend: browsers resolve any
# `*.localhost` name to 127.0.0.1 on their own, so `demo.localhost:3000` and
# `admin.localhost:3000` behave exactly as tenant and platform hosts do in
# production. See docs/LOCAL_SETUP.md §4.
APP_DOMAIN=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

# ── Database ──
DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ethr
DB_USERNAME=ethr
DB_PASSWORD=

# ── Redis ──
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ── Cache / Queue / Session ──
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=480
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=false

# ── Broadcasting (Reverb) ──
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=ethr
REVERB_APP_KEY=ethr-reverb-key
REVERB_APP_SECRET=ethr-reverb-secret
# REVERB_HOST is the client-facing host the broadcaster connects to — it must be
# reachable (never 0.0.0.0, which is a bind-only address). The server bind host is
# REVERB_SERVER_HOST (defaults to 0.0.0.0 in config/reverb.php).
REVERB_HOST=127.0.0.1
REVERB_PORT=8080

# ── File Storage (MinIO) ──
FILESYSTEM_DISK=minio
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=ethr_minio
MINIO_SECRET_KEY=ethr_minio_secret
MINIO_BUCKET=ethr
MINIO_USE_PATH_STYLE=true

# ── Mail ──
MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@ethr.et"
MAIL_FROM_NAME="ETHR"

# ── Sanctum ──
# Include tenant subdomains for local dev ({tenant}.localhost:3000) so the SPA
# session is treated as stateful on tenant hosts, not just bare localhost.
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,localhost:8888,127.0.0.1,127.0.0.1:8000,*.localhost,*.localhost:3000,ethr.et,*.ethr.et

# ── CORS ──
# Comma-separated list of allowed origins
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8888
# Regex patterns for dynamic tenant subdomains (production)
CORS_ALLOWED_ORIGINS_PATTERNS=

# ── Logging ──
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# ── Hashing ──
BCRYPT_ROUNDS=12

# ── SMS ──
# Options: log, ethiotelecom
SMS_DRIVER=log
# ETHIOTELECOM_API_KEY=
# ETHIOTELECOM_SENDER=

# ── Horizon ──
HORIZON_PREFIX=ethr_horizon:

# ── Health Check ──
# Set to receive email alerts on 500 errors
HEALTH_NOTIFY_EMAIL=

# ── Deployment ──
# Email to notify on deploy failure
DEPLOY_NOTIFY_EMAIL=
# Email to notify on backup failure
BACKUP_NOTIFY_EMAIL=
# Days to retain backups
BACKUP_RETENTION_DAYS=30
# Path for backup storage
BACKUP_PATH=/var/backups/ethr

# ── Frontend (Next.js) ──
# These are set in src/.env.local / src/.env.production
# NEXT_PUBLIC_REVERB_HOST=localhost
# NEXT_PUBLIC_REVERB_PORT=8080
# NEXT_PUBLIC_REVERB_SCHEME=http
# NEXT_PUBLIC_REVERB_APP_KEY=ethr-reverb-key

# ========================================
# Observability (self-hosted Sentry)
# ========================================
# Leave SENTRY_LARAVEL_DSN empty to disable reporting entirely — that is the
# default for local development and CI, where errors belong in the terminal.
# Point it at your own Sentry instance; ETHR takes no paid API dependencies.
# SENTRY_LARAVEL_DSN=https://<key>@sentry.your-host.et/<project>
# SENTRY_ENVIRONMENT=production
# SENTRY_RELEASE=

# Fraction of requests traced for performance (0.0–1.0). Tracing every request on a
# payroll run is expensive; 0.1 is a sane production starting point.
# SENTRY_TRACES_SAMPLE_RATE=0.1

# Keep this false. ETHR handles bank details, national IDs and TINs; sending default
# PII would ship in plaintext exactly what the database encrypts at rest. Payload
# scrubbing is enforced in config/sentry.php via App\Services\Observability\SentryScrubber.
# SENTRY_SEND_DEFAULT_PII=false

# ========================================
# Production Overrides
# ========================================
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://ethr.et
# APP_DOMAIN=ethr.et                 # required — apex vs tenant host
# SUPER_ADMIN_PASSWORD=CHANGE_ME     # required — seeder refuses without it
# SESSION_DOMAIN=                    # keep EMPTY: host-only session cookies
# SANCTUM_STATEFUL_DOMAINS=ethr.et,*.ethr.et   # apex must be listed too
# LOG_CHANNEL=stack
# LOG_STACK=daily
# LOG_LEVEL=error
# SESSION_SECURE_COOKIE=true
# BCRYPT_ROUNDS=12
# REDIS_PASSWORD=CHANGE_ME
# DB_ROOT_PASSWORD=CHANGE_ME
# CORS_ALLOWED_ORIGINS=https://ethr.et
# CORS_ALLOWED_ORIGINS_PATTERNS=https://*.ethr.et

# SMS — `log` (development, reports itself undeliverable) or `ethiotelecom`.
# Leaving this at `log` makes the notification-preferences UI show SMS as
# unavailable rather than offering a toggle nothing acts on.
SMS_DRIVER=log
SMS_DAILY_LIMIT_PER_USER=5
ETHIOTELECOM_SMS_ENDPOINT=
ETHIOTELECOM_SMS_USERNAME=
ETHIOTELECOM_SMS_PASSWORD=
ETHIOTELECOM_SMS_SENDER_ID=ETHR
