includes:
    - vendor/larastan/larastan/extension.neon
    - phpstan-baseline.neon

parameters:
    paths:
        - app/

    level: 6

    ignoreErrors:
        # Suppress missing array value types — these are annotation-only gaps,
        # not real bugs. The codebase uses untyped arrays extensively for
        # flexibility in config/data arrays. Fixing all would require significant
        # PHPDoc additions across the entire codebase.
        - identifier: missingType.iterableValue

        # Larastan cannot resolve the `payroll_rules` schema for App\Models\PayrollRule
        # (it resolves every other model's columns correctly), so analysing the
        # BelongsToTenant / HasPublicId traits "in context of" PayrollRule yields
        # false positives on $tenant_id / $public_id and on the trait method
        # generics. The model is correct and fully covered by PayrollAllowanceTest.
        # Scoped to the two trait files; the PayrollRule-named entries are exact.
        - message: '#^Access to an undefined property Illuminate\\Database\\Eloquent\\Model\:\:\$tenant_id\.$#'
          path: app/Traits/BelongsToTenant.php
        - message: '#^Method App\\Models\\PayrollRule\:\:tenant\(\) return type with generic class Illuminate\\Database\\Eloquent\\Relations\\BelongsTo does not specify its types\: TRelatedModel, TDeclaringModel$#'
          path: app/Traits/BelongsToTenant.php
        - message: '#^Access to an undefined property Illuminate\\Database\\Eloquent\\Model\:\:\$public_id\.$#'
          path: app/Traits/HasPublicId.php
        - message: '#^Method App\\Models\\PayrollRule\:\:findByPublicId\(\) should return static\(App\\Models\\PayrollRule\)\|null but returns App\\Models\\PayrollRule\|null\.$#'
          path: app/Traits/HasPublicId.php

        # Same larastan limitation for the onboarding-v2 tables it cannot yet
        # introspect (employee_external_identities, migration_batches,
        # migration_staging_rows): the BelongsToTenant / HasPublicId trait
        # generics resolve to false positives "in context of" the new models.
        # The models are correct and covered by IdentityResolutionTest and
        # MigrationWorkspaceTest. Scoped to the trait files, model-named exact.
        - message: '#^Method App\\Models\\EmployeeExternalIdentity\:\:tenant\(\) return type with generic class Illuminate\\Database\\Eloquent\\Relations\\BelongsTo does not specify its types\: TRelatedModel, TDeclaringModel$#'
          path: app/Traits/BelongsToTenant.php
        - message: '#^Method App\\Models\\EmployeeExternalIdentity\:\:findByPublicId\(\) should return static\(App\\Models\\EmployeeExternalIdentity\)\|null but returns App\\Models\\EmployeeExternalIdentity\|null\.$#'
          path: app/Traits/HasPublicId.php
        - message: '#^Method App\\Models\\MigrationBatch\:\:tenant\(\) return type with generic class Illuminate\\Database\\Eloquent\\Relations\\BelongsTo does not specify its types\: TRelatedModel, TDeclaringModel$#'
          path: app/Traits/BelongsToTenant.php
        - message: '#^Method App\\Models\\MigrationBatch\:\:findByPublicId\(\) should return static\(App\\Models\\MigrationBatch\)\|null but returns App\\Models\\MigrationBatch\|null\.$#'
          path: app/Traits/HasPublicId.php
        - message: '#^Method App\\Models\\MigrationStagingRow\:\:tenant\(\) return type with generic class Illuminate\\Database\\Eloquent\\Relations\\BelongsTo does not specify its types\: TRelatedModel, TDeclaringModel$#'
          path: app/Traits/BelongsToTenant.php
        - message: '#^Method App\\Models\\MigrationStagingRow\:\:findByPublicId\(\) should return static\(App\\Models\\MigrationStagingRow\)\|null but returns App\\Models\\MigrationStagingRow\|null\.$#'
          path: app/Traits/HasPublicId.php

        # Same larastan limitation again for `employee_cost_sharing`, and here the
        # trigger is identifiable: the table name is singular (set explicitly via
        # $table, because "cost sharing" is a mass noun) so larastan's convention-
        # based schema lookup misses it, and the BelongsToTenant / HasPublicId
        # trait generics then resolve to false positives "in context of" the model.
        # The model is correct and covered by CostSharingTest, PayrollCostSharingTest
        # and CostSharingApiTest. Scoped to the trait files, model-named exact.
        - message: '#^Method App\\Models\\EmployeeCostSharing\:\:tenant\(\) return type with generic class Illuminate\\Database\\Eloquent\\Relations\\BelongsTo does not specify its types\: TRelatedModel, TDeclaringModel$#'
          path: app/Traits/BelongsToTenant.php
        - message: '#^Method App\\Models\\EmployeeCostSharing\:\:findByPublicId\(\) should return static\(App\\Models\\EmployeeCostSharing\)\|null but returns App\\Models\\EmployeeCostSharing\|null\.$#'
          path: app/Traits/HasPublicId.php

        # Same larastan limitation again for profile_update_requests. The model is
        # correct and covered by ProfileUpdateRequestTest; only the trait generics
        # resolve to false positives "in context of" it. Scoped to the trait files,
        # model-named exact.
        - message: '#^Method App\\Models\\ProfileUpdateRequest\:\:tenant\(\) return type with generic class Illuminate\\Database\\Eloquent\\Relations\\BelongsTo does not specify its types\: TRelatedModel, TDeclaringModel$#'
          path: app/Traits/BelongsToTenant.php
        - message: '#^Method App\\Models\\ProfileUpdateRequest\:\:findByPublicId\(\) should return static\(App\\Models\\ProfileUpdateRequest\)\|null but returns App\\Models\\ProfileUpdateRequest\|null\.$#'
          path: app/Traits/HasPublicId.php

        # Same larastan limitation for personnel_actions — its JSON `changes`
        # column stops larastan introspecting the table, so the trait generics
        # resolve to false positives "in context of" PersonnelAction. The model
        # is correct (property types declared via @property) and covered by
        # PersonnelActionTest. Scoped to the trait files, model-named exact.
        - message: '#^Method App\\Models\\PersonnelAction\:\:tenant\(\) return type with generic class Illuminate\\Database\\Eloquent\\Relations\\BelongsTo does not specify its types\: TRelatedModel, TDeclaringModel$#'
          path: app/Traits/BelongsToTenant.php
        - message: '#^Method App\\Models\\PersonnelAction\:\:findByPublicId\(\) should return static\(App\\Models\\PersonnelAction\)\|null but returns App\\Models\\PersonnelAction\|null\.$#'
          path: app/Traits/HasPublicId.php

        # Same larastan limitation for the shift-rotation models. Verified as a
        # limitation rather than a schema gap: the errors persist unchanged when
        # analysing against a fully migrated database, so they are not the usual
        # "table not in the dev schema" symptom. Both models are correct and
        # covered by ShiftRotationTest and ShiftRotationApiTest. Scoped to the
        # trait files, model-named exact.
        - message: '#^Method App\\Models\\ShiftRotation\:\:tenant\(\) return type with generic class Illuminate\\Database\\Eloquent\\Relations\\BelongsTo does not specify its types\: TRelatedModel, TDeclaringModel$#'
          path: app/Traits/BelongsToTenant.php
        - message: '#^Method App\\Models\\ShiftRotationStep\:\:tenant\(\) return type with generic class Illuminate\\Database\\Eloquent\\Relations\\BelongsTo does not specify its types\: TRelatedModel, TDeclaringModel$#'
          path: app/Traits/BelongsToTenant.php
        - message: '#^Method App\\Models\\ShiftRotation\:\:findByPublicId\(\) should return static\(App\\Models\\ShiftRotation\)\|null but returns App\\Models\\ShiftRotation\|null\.$#'
          path: app/Traits/HasPublicId.php

        # Same larastan limitation for disciplinary_cases — its JSON
        # `investigation_notes` column stops larastan introspecting the table,
        # so the trait generics resolve to false positives "in context of"
        # DisciplinaryCase. The model is correct (property types declared via
        # @property) and covered by DisciplinaryCaseTest. Scoped to the trait
        # files, model-named exact.
        - message: '#^Method App\\Models\\DisciplinaryCase\:\:tenant\(\) return type with generic class Illuminate\\Database\\Eloquent\\Relations\\BelongsTo does not specify its types\: TRelatedModel, TDeclaringModel$#'
          path: app/Traits/BelongsToTenant.php
        - message: '#^Method App\\Models\\DisciplinaryCase\:\:findByPublicId\(\) should return static\(App\\Models\\DisciplinaryCase\)\|null but returns App\\Models\\DisciplinaryCase\|null\.$#'
          path: app/Traits/HasPublicId.php

        # Employee::$status resolving to plain `string` instead of the cast
        # EmployeeStatus enum is a pre-existing, already-accepted larastan
        # limitation — EmployeeTransitionController.php carries the identical
        # three messages in phpstan-baseline.neon (lines 244-259). Verified: it
        # is the same false positive, not a new bug, just hit for the first
        # time from a *Service* class rather than a Controller. Listed here
        # (rather than regenerating the baseline) so the entries stay
        # attributable to this change. Covered by DisciplinaryCaseTest, which
        # exercises the termination-on-close path this touches.
        - message: '#^Cannot call method canTransitionTo\(\) on string\.$#'
          count: 1
          path: app/Services/DisciplinaryCaseService.php
        - message: '#^Cannot access property \$value on string\.$#'
          count: 3
          path: app/Services/DisciplinaryCaseService.php
        - message: '#^Property App\\Models\\Employee\:\:\$status \(string\) does not accept App\\Enums\\EmployeeStatus\:\:TERMINATED\.$#'
          count: 1
          path: app/Services/DisciplinaryCaseService.php

        # Same larastan limitation for employee_contracts — no JSON column on
        # this table, so it's confirmed *not* a JSON-column-specific issue:
        # enum-cast property types resolve to their raw backing type (string)
        # regardless, reproduced even on a minimal schema-clean model. Model
        # is correct (property types declared via @property) and covered by
        # EmployeeContractTest.
        - message: '#^Method App\\Models\\EmployeeContract\:\:tenant\(\) return type with generic class Illuminate\\Database\\Eloquent\\Relations\\BelongsTo does not specify its types\: TRelatedModel, TDeclaringModel$#'
          path: app/Traits/BelongsToTenant.php
        - message: '#^Method App\\Models\\EmployeeContract\:\:findByPublicId\(\) should return static\(App\\Models\\EmployeeContract\)\|null but returns App\\Models\\EmployeeContract\|null\.$#'
          path: app/Traits/HasPublicId.php

        # Same as the two entries above, for grade_salary_steps.
        - message: '#^Method App\\Models\\GradeSalaryStep\:\:tenant\(\) return type with generic class Illuminate\\Database\\Eloquent\\Relations\\BelongsTo does not specify its types\: TRelatedModel, TDeclaringModel$#'
          path: app/Traits/BelongsToTenant.php
        - message: '#^Method App\\Models\\GradeSalaryStep\:\:findByPublicId\(\) should return static\(App\\Models\\GradeSalaryStep\)\|null but returns App\\Models\\GradeSalaryStep\|null\.$#'
          path: app/Traits/HasPublicId.php

        # Same as the entries above, for retirement_cases. No JSON column here
        # either, and RetirementCaseService touches more enum-cast properties
        # than the earlier services did (status, decision, plus two Carbon
        # casts), so the fallout is wider — every message below is the same
        # root cause (enum/Carbon casts resolving to their raw backing type),
        # not distinct bugs. Model is correct (casts() declares the real
        # types) and covered by RetirementCaseTest.
        - message: '#^Method App\\Models\\RetirementCase\:\:tenant\(\) return type with generic class Illuminate\\Database\\Eloquent\\Relations\\BelongsTo does not specify its types\: TRelatedModel, TDeclaringModel$#'
          path: app/Traits/BelongsToTenant.php
        - message: '#^Method App\\Models\\RetirementCase\:\:findByPublicId\(\) should return static\(App\\Models\\RetirementCase\)\|null but returns App\\Models\\RetirementCase\|null\.$#'
          path: app/Traits/HasPublicId.php
        - message: '#^Property App\\Models\\RetirementCase\:\:\$status \(string\) does not accept App\\Enums\\RetirementCaseStatus\:\:.*\.$#'
          path: app/Services/RetirementCaseService.php
        - message: '#^Property App\\Models\\RetirementCase\:\:\$decision \(string\|null\) does not accept App\\Enums\\RetirementDecision\:\:.*\.$#'
          path: app/Services/RetirementCaseService.php
        - message: '#^Property App\\Models\\RetirementCase\:\:\$decided_at \(string\|null\) does not accept Illuminate\\Support\\Carbon\.$#'
          path: app/Services/RetirementCaseService.php
        - message: '#^Property App\\Models\\RetirementCase\:\:\$finalized_at \(string\|null\) does not accept Illuminate\\Support\\Carbon\.$#'
          path: app/Services/RetirementCaseService.php
        - message: '#^Property App\\Models\\Employee\:\:\$status \(string\) does not accept App\\Enums\\EmployeeStatus\:\:RETIRED\.$#'
          path: app/Services/RetirementCaseService.php
        - message: '#^Cannot access property \$value on string\.$#'
          count: 7
          path: app/Services/RetirementCaseService.php
        - message: '#^Cannot call method canTransitionTo\(\) on string\.$#'
          count: 2
          path: app/Services/RetirementCaseService.php
        - message: '#^Strict comparison using === between string and App\\Enums\\RetirementCaseStatus\:\:INITIATED will always evaluate to false\.$#'
          path: app/Services/RetirementCaseService.php
        - message: '#^Call to function in_array\(\) with arguments string, array\{App\\Enums\\RetirementCaseStatus\:\:REJECTED, App\\Enums\\RetirementCaseStatus\:\:FINALIZED, App\\Enums\\RetirementCaseStatus\:\:CANCELLED\} and true will always evaluate to false\.$#'
          path: app/Services/RetirementCaseService.php
        - message: '#^Cannot access property \$value on string\.$#'
          count: 3
          path: app/Http/Resources/RetirementCaseResource.php
        - message: '#^Cannot call method toDateString\(\) on string\.$#'
          path: app/Http/Resources/RetirementCaseResource.php
        - message: '#^Cannot call method toIso8601String\(\) on string\.$#'
          count: 2
          path: app/Http/Resources/RetirementCaseResource.php

        # `HasFactory`'s generic isn't specified anywhere in this codebase —
        # every other model using it (Employee, Announcement, Branch, …) has
        # the identical message baselined in phpstan-baseline.neon instead.
        # Listed here for the two models this session added, rather than
        # regenerating that 4800+ line file for two lines' worth of change.
        - message: '#^Class App\\Models\\DisciplinaryCase uses generic trait Illuminate\\Database\\Eloquent\\Factories\\HasFactory but does not specify its types\: TFactory$#'
          path: app/Models/DisciplinaryCase.php
        - message: '#^Class App\\Models\\EmployeeContract uses generic trait Illuminate\\Database\\Eloquent\\Factories\\HasFactory but does not specify its types\: TFactory$#'
          path: app/Models/EmployeeContract.php
        - message: '#^Class App\\Models\\GradeSalaryStep uses generic trait Illuminate\\Database\\Eloquent\\Factories\\HasFactory but does not specify its types\: TFactory$#'
          path: app/Models/GradeSalaryStep.php
        - message: '#^Class App\\Models\\RetirementCase uses generic trait Illuminate\\Database\\Eloquent\\Factories\\HasFactory but does not specify its types\: TFactory$#'
          path: app/Models/RetirementCase.php

        # JsonResource resolves its wrapped model's attributes at runtime through
        # __get, so PHPStan sees every field access as an undefined property.
        # Every other resource in the codebase carries the same errors in
        # phpstan-baseline.neon; these three are listed here instead of
        # regenerating that file, so the entries stay attributable to this change
        # rather than being absorbed into an 806-line blob.
        - message: '#^Access to an undefined property App\\Http\\Resources\\ShiftRotationResource\:\:\$[a-z_]+\.$#'
          path: app/Http/Resources/ShiftRotationResource.php
        - message: '#^Access to an undefined property App\\Http\\Resources\\ShiftRotationStepResource\:\:\$[a-z_]+\.$#'
          path: app/Http/Resources/ShiftRotationStepResource.php
        - message: '#^Access to an undefined property App\\Http\\Resources\\ShiftAssignmentResource\:\:\$(rotation|shift_rotation_id|anchor_date)\.$#'
          path: app/Http/Resources/ShiftAssignmentResource.php

        # OrganizationProvisioner works over a class-string<Model> that is only
        # known to soft-delete at runtime (guarded by class_uses_recursive), so
        # PHPStan cannot see withTrashed()/trashed()/restore() — they are added by
        # the SoftDeletes scope, not declared on Model. The guard makes the calls
        # safe; covered by OrganizationProvisionerTest's restore/idempotency cases.
        - message: '#^Call to an undefined method Illuminate\\Database\\Eloquent\\(Builder|Model)(<[^>]+>)?\:\:(withTrashed|trashed|restore)\(\)\.$#'
          path: app/Services/Onboarding/OrganizationProvisioner.php

        # Larastan resolves the Tenant::$settings cast to `array{}|string`, so it
        # believes the merged-vs-original settings comparison is always true. At
        # runtime $tenant->settings is a populated array; the guard prevents a
        # redundant write in the skip-only case. Covered by the settings-merge test.
        - message: '#^Strict comparison using \!== between non-empty-array<mixed> and array\{\}\|string will always evaluate to true\.$#'
          path: app/Services/Onboarding/OrganizationProvisioner.php

        # False positive, confirmed by two independent rewrites of the producing
        # method (a fluent Collection chain, then a plain foreach) that both
        # triggered the identical complaint — the cause is in how Larastan
        # resolves the private method's declared ?EmployeeBankDetail return type
        # at this call site, not in the code shape. Removing the nullsafe operator
        # as suggested would throw at runtime when an employee has no bank detail
        # on record; BankExportServiceTest's "leaves the bank columns blank rather
        # than erroring when no bank detail exists" case exercises exactly that
        # path and passes, proving the null branch is real and reachable.
        - message: '#^Using nullsafe property access "\?->(bank_name|account_number)" on left side of \?\? is unnecessary\. Use -> instead\.$#'
          path: app/Services/Payroll/BankExportService.php

    excludePaths:
