# =========================================================
# ETHR API — Ethio Telecom SHARED HOSTING (Plesk) environment template
#
#   Target:  ethr.et   ·   account `ethret` @ lin6.ethiotelecom.et
#   App at:  ~/ethr/api/.env        (NOT under ~/httpdocs/)
#
# WHY THIS FILE EXISTS, AND WHY IT IS NOT `.env.production.example`.
#
# `.env.production.example` is a docker-compose.prod.yml artifact — its own
# header says so, and it is injected into the api, worker-*, scheduler and
# reverb containers via `env_file:`. It selects redis for cache, queue and
# session, minio for storage, reverb for broadcasting, and a read-replica
# database user. NONE of that exists on Plesk shared hosting, and
# `REDIS_HOST=redis` / `MINIO_ENDPOINT=http://minio:9000` are Docker service
# hostnames that resolve to nothing outside a compose network.
#
# `DEPLOYMENT.md` step 4 says `cp .env.production.example .env`. On this target
# that produces an application that cannot boot. Copy THIS file instead.
#
# The VPS template is deliberately left unchanged: it is still correct for the
# rollback target, and rollback is not yet retired.
#
# EVERY CONVERSION BELOW IS MARKED  # [shared-hosting]  WITH ITS REASON.
#
# NEVER commit the filled-in copy. `api/.gitignore` already covers `.env`.
# =========================================================


APP_NAME=ETHR
APP_ENV=production
APP_KEY=                           # REQUIRED: php artisan key:generate --show
APP_DEBUG=false
APP_URL=https://www.ethr.et          # [shared-hosting] D-5: Plesk 301s the apex to www
APP_TIMEZONE=UTC
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

# Tenancy root domain — REQUIRED in production, and silent when missing.
# ResolveTenant reads it to tell the apex (`ethr.et`, no tenant) from a tenant
# host (`habru.ethr.et`). Without it the middleware falls back to counting
# labels, which read `ethr.et` itself as a tenant named "ethr". Note that
# `APP_DOMAIN=` is an empty string, not null — see App\Support\TenancyDomain,
# which is why every consumer goes through it rather than a bare null check.
APP_DOMAIN=ethr.et

# ── Database ──
# mariadb, not mysql. Only the `mariadb` connection in config/database.php
# declares the `read` array, so DB_CONNECTION=mysql silently discards
# DB_READ_HOST and sends every read to the primary — the replica then sits
# idle and the health endpoint reports database_read: not_configured.
DB_CONNECTION=mariadb
DB_HOST=localhost                    # [shared-hosting] Plesk MariaDB is local to the account
DB_PORT=3306
DB_DATABASE=ethr
DB_USERNAME=ethr
DB_PASSWORD=                         # [shared-hosting] REQUIRED: the Plesk database user password
DB_ROOT_PASSWORD=                    # [shared-hosting] LEAVE EMPTY. Plesk grants no root DB access

# Read replica — [shared-hosting] NOT APPLICABLE.
# The VPS template documents a read/write split against a `mariadb-replica`
# container. Plesk provisions ONE database and ONE user, so leave both blank.
# Laravel then serves reads and writes from the single connection, which is the
# intended behaviour here, not a degraded one. Expect the health endpoint to
# report `database_read: not_configured`; on this target that is correct.
DB_READ_USERNAME=                    # [shared-hosting] LEAVE EMPTY. No read replica on shared hosting
DB_READ_PASSWORD=                    # [shared-hosting] LEAVE EMPTY. No read replica

# ── Redis — [shared-hosting] NOT USED ──
# There is no Redis on this account. Every value in this block is inert while
# CACHE_STORE, QUEUE_CONNECTION and SESSION_DRIVER avoid the redis driver, and
# they do. The keys are kept rather than deleted so this file stays diffable
# against the VPS template.
REDIS_CLIENT=phpredis                # [shared-hosting] unused; ext-redis is optional here
REDIS_HOST=127.0.0.1                 # [shared-hosting] was `redis`, a Docker service name
REDIS_PASSWORD=                      # [shared-hosting] LEAVE EMPTY. Redis is not used here
REDIS_PORT=6379

# ── Cache / Queue / Session ──
# These three are `database`, not `file`, and that is not a style preference.
# ENVIRONMENT.md D-8 records CACHE_STORE=database as LIVE-VERIFIED against real
# MariaDB on 2026-08-31, because `config/database.php`'s `cache_locks` table is
# what Laravel's database cache driver needs for `Cache::lock()` — the primitive
# `->withoutOverlapping()` uses internally, at 8 call sites in
# `routes/console.php`. Swapping to `file` would move those locks onto an
# unverified implementation for no gain.
CACHE_STORE=database                 # [shared-hosting] was `redis`. LIVE-VERIFIED on MariaDB 2026-08-31
QUEUE_CONNECTION=database            # [shared-hosting] was `redis`. REQUIRES a runner — see G0-D
SESSION_DRIVER=database              # [shared-hosting] was `redis`. Matches ENVIRONMENT.md D-8
SESSION_LIFETIME=480

# Leave SESSION_DOMAIN EMPTY. An empty value gives host-only cookies, which is
# what stops habru.ethr.et's session from ever being sent to woldia.ethr.et.
# Setting it to `.ethr.et` would "fix" cross-subdomain flows by turning every
# user's session into a domain-wide credential — this is a tenant-isolation
# boundary, not a convenience setting.
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=true

# ── Broadcasting (Reverb) ──
# [shared-hosting] Reverb does not run here — it is a long-running WebSocket
# daemon and this account runs no daemons. BROADCAST_CONNECTION is `null` above,
# so every value in this block stays empty. The key-matching hazard described for
# the VPS build does not arise, because nothing performs a handshake.

BROADCAST_CONNECTION=null            # [shared-hosting] was `reverb`; no daemon. See the note below
REVERB_APP_ID=ethr
REVERB_APP_KEY=                      # [shared-hosting] LEAVE EMPTY while BROADCAST_CONNECTION=null
REVERB_APP_SECRET=                   # [shared-hosting] LEAVE EMPTY while BROADCAST_CONNECTION=null
REVERB_HOST=                         # [shared-hosting] LEAVE EMPTY. No Reverb daemon
REVERB_PORT=8080

# ── File Storage — [shared-hosting] LOCAL DISK ──
# `local` writes under api/storage/app, which sits in ~/ethr/, outside the
# document root. The MinIO keys below are inert and kept only for diffability
# against the VPS template.
#
# Worth carrying over from that template: the default disk must never be left
# pointing at `s3`. config/filesystems.php's s3 disk reads AWS_* variables this
# file does not define, so the AWS SDK throws "A 'region' configuration value is
# required" the moment anything touches it — and BackupTenantJob is a caller of
# the default disk, so every tenant backup failed in production when that
# happened. `local` is the safe explicit choice.
FILESYSTEM_DISK=local                # [shared-hosting] was `minio`
MINIO_ENDPOINT=                      # [shared-hosting] was http://minio:9000, a Docker service name
MINIO_ACCESS_KEY=                    # [shared-hosting] LEAVE EMPTY. MinIO is not used here
MINIO_SECRET_KEY=                    # [shared-hosting] LEAVE EMPTY. MinIO is not used here
MINIO_BUCKET=ethr
MINIO_USE_PATH_STYLE=true

# ── Mail ──
# There is no MAIL_ENCRYPTION in Laravel 12 — config/mail.php reads MAIL_SCHEME,
# and an MAIL_ENCRYPTION line is inert. Leave MAIL_SCHEME unset for port 587
# (STARTTLS is negotiated automatically); set it to `smtps` only for implicit
# TLS on port 465.
MAIL_MAILER=smtp
MAIL_HOST=                         # REQUIRED: real SMTP host — password reset is dead without it
MAIL_PORT=587
MAIL_USERNAME=                     # REQUIRED
MAIL_PASSWORD=                     # REQUIRED
# MAIL_SCHEME=smtps                # only for port 465
MAIL_FROM_ADDRESS=noreply@ethr.et
MAIL_FROM_NAME=ETHR

# Where public contact-form leads are emailed. Unset is a SUPPORTED state, not a
# broken one: ContactController still persists the lead and writes
# "Lead saved; no contact inbox configured" at info level. But that log line is
# the only signal, so a deployment that leaves this blank collects leads nobody
# is told about. Decide it deliberately rather than by omission.
# CONTACT_INBOX=sales@ethr.et

# ── Sanctum ──
# BOTH entries are required. Sanctum matches with Str::is(), and `*.ethr.et`
# does NOT match the bare apex `ethr.et` — with the wildcard alone, requests
# from https://ethr.et are not treated as stateful, so EncryptCookies /
# StartSession never run and login on the apex cannot set a session cookie.
SANCTUM_STATEFUL_DOMAINS=ethr.et,*.ethr.et

# ── CORS ──
CORS_ALLOWED_ORIGINS=https://www.ethr.et   # [shared-hosting] D-5: must match APP_URL or the browser blocks every call
# Delimited, because config/cors.php hands this straight to preg_match, which
# rejects an undelimited pattern outright ("Delimiter must not be alphanumeric")
# and returns false for every origin. A glob such as `https://*.ethr.et` is NOT
# a valid pattern here and matches nothing. Browser traffic never notices —
# nginx serves the SPA and the API same-origin — but genuine cross-origin
# clients on {tenant}.ethr.et are refused.
CORS_ALLOWED_ORIGINS_PATTERNS=#^https://[a-z0-9-]+\.ethr\.et$#

# ── Logging ──
# `daily` (not `single`). The VPS reason was a shared container volume filling
# up; the [shared-hosting] reason is stronger, not weaker — this account has a
# fixed disk quota, an unrotated laravel.log grows without bound, and when the
# quota is reached every write path fails, including the database's. `daily`
# rotates and prunes to LOG_DAILY_DAYS. Check usage in Plesk → Statistics;
# there is no `du -sh` without shell access.
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=error
LOG_DAILY_DAYS=14

# ── Hashing ──
BCRYPT_ROUNDS=12

# ── SMS ──
# `log` reports itself undeliverable, which keeps the notification-preferences
# UI honest until real operator credentials exist. There is no SMS_API_KEY —
# config/sms.php reads the four ETHIOTELECOM_SMS_* values below.
SMS_DRIVER=log
# SMS_DRIVER=ethiotelecom
SMS_DAILY_LIMIT_PER_USER=5
ETHIOTELECOM_SMS_ENDPOINT=
ETHIOTELECOM_SMS_USERNAME=
ETHIOTELECOM_SMS_PASSWORD=
ETHIOTELECOM_SMS_SENDER_ID=ETHR

# ── Horizon ──
HORIZON_PREFIX=                      # [shared-hosting] Horizon needs Redis and a daemon; neither exists

# ── Super admin ──
# Deliberately absent, not forgotten. The production path creates the platform
# account interactively with `php artisan ethr:create-admin`, which does not
# read this variable at all. SUPER_ADMIN_PASSWORD is consulted only by
# DatabaseSeeder — the development seeder, which also creates a demo tenant and
# must never run against production — where it exists purely as a guard that
# refuses to seed a known-password super admin. Setting it here does not create
# an account; it only makes that guard passable, so leave it unset.

# ── Observability (self-hosted Sentry) ──
# Optional. Empty disables reporting entirely. Without it, an unhandled
# exception or a failed queue job leaves only a log line and a failed_jobs row.
# SENTRY_LARAVEL_DSN=https://<key>@sentry.your-host.et/<project>
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0.1
# Keep PII off: ETHR handles bank details, national IDs and TINs, and sending
# default PII would ship in plaintext exactly what the database encrypts at rest.
# SENTRY_SEND_DEFAULT_PII=false

# ── Operational scripts ──
# DEPLOY_NOTIFY_EMAIL, BACKUP_NOTIFY_EMAIL, BACKUP_RETENTION_DAYS, BACKUP_PATH
# and COMPOSE_FILE are deliberately NOT set here. scripts/deploy.sh and
# scripts/backup.sh read them from their own shell environment — nothing sources
# this file — so a value written here is inert. Set them in the cron entry or
# the invoking shell instead:
#
#   BACKUP_PATH=/mnt/backups /opt/ethr/scripts/backup.sh

# =========================================================
# WHAT THIS FILE CANNOT FIX — read before deploying
# =========================================================
#
# QUEUE_CONNECTION=database needs something to drain the queue.
#   16 job classes write to it. With no runner they accumulate forever and no
#   queued email is ever sent. G0-D is FAIL — there is no Scheduled Tasks
#   section on this subscription — so at present NOTHING drains it.
#   Blocked on the support request: docs/deployment/ETHIO-TELECOM-SUPPORT-REQUEST.md
#
# BROADCAST_CONNECTION=null disables real-time updates.
#   Reverb is a long-running WebSocket daemon and shared hosting does not run
#   daemons. `null` is chosen over `reverb` deliberately: with `reverb` set and
#   no server listening, a broadcast THROWS, so a successful write returns 500.
#   `null` degrades the feature instead of breaking the write.
#
# MAIL_* must point at a real SMTP service.
#   Outbound 587/465 is G0-H, NOT VERIFIED. If the host blocks outbound SMTP,
#   no mail leaves regardless of these values.
#
# Nothing here grants a PHP extension. ext-gd, ext-pdo and ext-pdo_mysql are
# declared in composer.json and `composer install` now ABORTS without them;
# the rest are enabled in the Plesk PHP settings page. The full list is in
# docs/deployment/PLESK-SETUP.md.

# ── HTTP-driven scheduler and queue (shared hosting only) ────────────────────
# Leave EMPTY unless this deployment has no cron. When empty the /api/v1/cron
# routes 404 and do not exist. Generate with: openssl rand -hex 32
# Minimum 32 characters -- a shorter value is refused and the routes stay 404.
CRON_TOKEN=
CRON_QUEUE_MAX_SECONDS=50
CRON_LOCK_SECONDS=110
