# =========================================================
# ETHR — Docker Compose environment (root)
# =========================================================
# docker-compose.prod.yml interpolates the ${VARS} below when it starts the
# mariadb / redis / minio services. This file is the
# SINGLE source for those compose-level values.
#
#   cp .env.example .env      # then fill in every REQUIRED value
#
# NOTE: this is separate from api/.env.production (injected INTO the api
# container via env_file). Passwords that appear in both places — REDIS_PASSWORD,
# DB_PASSWORD, MinIO keys — MUST match between the two files or services will
# fail to authenticate to each other.
# Never commit the real .env (it is gitignored); commit only this template.
# =========================================================

# ── Database (REQUIRED) ──
DB_DATABASE=ethr
DB_USERNAME=ethr
DB_PASSWORD=                 # REQUIRED: strong random password (match api/.env.production DB_PASSWORD)
DB_ROOT_PASSWORD=           # REQUIRED: strong random MariaDB root password

# ── Read replica ──
DB_READ_USERNAME=ethr_read
DB_READ_PASSWORD=           # optional: defaults to DB_PASSWORD if left blank

# ── Redis (REQUIRED) ──
REDIS_PASSWORD=             # REQUIRED: strong random password (match api/.env.production REDIS_PASSWORD)

# ── MinIO object storage (REQUIRED) ──
MINIO_ACCESS_KEY=          # REQUIRED (match api/.env.production MINIO_ACCESS_KEY)
MINIO_SECRET_KEY=          # REQUIRED, min 8 chars (match api/.env.production MINIO_SECRET_KEY)

# ── Service scaling ──
# Intentionally absent. API_REPLICAS / WORKER_REPLICAS / REVERB_REPLICAS used to
# live here and no longer do anything, because raising them did not do what the
# name promised:
#
#   api, reverb — infrastructure/nginx.conf declares static upstreams
#     (`server api:9000;`), which nginx resolves ONCE at startup. A second
#     replica got no traffic at all while still consuming its reservations.
#     Scaling these needs `resolver 127.0.0.11 valid=10s;` and a variable-based
#     fastcgi_pass/proxy_pass in nginx first.
#
#   worker — replaced by three purpose-built services (worker-realtime,
#     worker-notifications, worker-heavy). Queue throughput is now tuned with
#     `maxProcesses` per supervisor in api/config/horizon.php, which is where
#     the memory ceiling is actually decided, rather than by duplicating every
#     supervisor into a second container.

# ── Frontend build args (baked into the Next.js image at build time) ──
NEXT_PUBLIC_API_URL=https://ethr.et
NEXT_PUBLIC_APP_NAME=ETHR
NEXT_PUBLIC_APP_URL=https://ethr.et
NEXT_PUBLIC_REVERB_HOST=ethr.et
NEXT_PUBLIC_REVERB_PORT=443
NEXT_PUBLIC_REVERB_SCHEME=https
