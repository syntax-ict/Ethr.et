# Dependencies
node_modules/
vendor/

# Build output
.next/
api/public/build/
src/tsconfig.tsbuildinfo

# Environment
.env
.env.local
.env.*.local
.env.save
*.save
api/.env
api/.env.save

# Real production env files. api/.env.production holds APP_KEY, the database
# password and ETHIOTELECOM_SMS_PASSWORD; only the *.example templates belong
# in Git. Laravel's own api/.gitignore already covers it - this repeats the rule
# at the root so the whole env policy is readable in one place.
#
# src/.env.production is the deliberate exception and stays tracked: it holds
# only NEXT_PUBLIC_* values, which are compiled into the client bundle and are
# public by definition, and the production build needs them. Nothing secret may
# be added to it - a server-side secret belongs in the host environment.
api/.env.production
.env.production.local

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Docker volumes
mariadb_data/
redis_data/
minio_data/

# Backups. A single backup directory contains the ENTIRE dataset - salary
# history, bank details, scanned identity documents - plus every audit_log row.
# Committing one would be a larger disclosure than any credential in this repo.
# The default BACKUP_PATH is api/storage/backups; anywhere else it lands, the
# *.sql and archive patterns below still catch the artefacts.
api/storage/backups/
storage/backups/
*.sql
*.sql.gz
ethr-*.tar.gz

# PHP
api/storage/logs/*.log
api/storage/framework/cache/data/*
api/storage/framework/sessions/*
api/storage/framework/views/*
api/bootstrap/cache/*.php

# Test
coverage/
.phpunit.result.cache
src/test-results/
src/playwright-report/
src/lighthouse-reports/
src/e2e/.auth/
docker-compose.override.yml

# Scratch dir created and removed by scripts/prod-build-test.sh
.prod-test-tmp/

# Claude Code local dev-server wiring (machine-specific, not team config)
.claude/launch.json
