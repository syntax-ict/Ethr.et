# Dependencies
node_modules/
vendor/

# Build output
.next/
# `ETHR_TARGET=shared-hosting next build` writes here instead of .next/standalone.
# 689 files on the last run; nothing was ignoring them.
src/out/
api/public/build/
src/tsconfig.tsbuildinfo

# scripts/shared-hosting/deploy.sh packages the release here (ARTIFACT_DIR).
# Not ignored until 2026-09-27, and it matters more than a stray directory: the
# `api.tar.gz` it writes is `tar -C <root> api`, so on any machine where
# `api/.env` exists the tarball contains APP_KEY and the database password. An
# untracked-but-committable archive of the production secrets is not a thing to
# leave to `git add -A`. (The `.prod-test-tmp/` entry that used to sit here went
# with prod-build-test.sh in 3db9904 — same class of entry, same reason.)
.deploy-artifacts/

# Environment
.env
.env.local
.env.*.local
.env.save
*.save
api/.env
api/.env.save

# Real production env files. api/.env.production holds APP_KEY, the database
# password and ETHIOTELECOM_SMS_PASSWORD; only the *.example templates belong
# in Git. Laravel's own api/.gitignore already covers it - this repeats the rule
# at the root so the whole env policy is readable in one place.
#
# src/.env.production is the deliberate exception and stays tracked: it holds
# only NEXT_PUBLIC_* values, which are compiled into the client bundle and are
# public by definition, and the production build needs them. Nothing secret may
# be added to it - a server-side secret belongs in the host environment.
api/.env.production
.env.production.local

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Backups. A single backup directory contains the ENTIRE dataset - salary
# history, bank details, scanned identity documents - plus every audit_log row.
# Committing one would be a larger disclosure than any credential in this repo.
# The default BACKUP_PATH is api/storage/backups; anywhere else it lands, the
# *.sql and archive patterns below still catch the artefacts.
api/storage/backups/
storage/backups/
*.sql
*.sql.gz
ethr-*.tar.gz

# PHP
api/storage/logs/*.log
api/storage/framework/cache/data/*
api/storage/framework/sessions/*
api/storage/framework/views/*
api/bootstrap/cache/*.php

# Test
coverage/
.phpunit.result.cache
src/test-results/
src/playwright-report/
src/lighthouse-reports/
# LHCI's own scratch state, written beside the reports whenever the
# `lighthouse` gate runs. Reports were already ignored; this was not, so
# the first real run of that gate left it staged.
src/.lighthouseci/
src/e2e/.auth/

